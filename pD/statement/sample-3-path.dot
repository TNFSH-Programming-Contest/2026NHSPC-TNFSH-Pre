    node [shape=point, fixedsize=true, width=0.01, height=0.01,
          label="", style=invis];
    c12_tl [pos="30,86!"];
    c12_br [pos="86,30!"];
    c21_bl [pos="-28,-28!"];
    c21_tr [pos="28,28!"];
    c22_bl [pos="30,-28!"];
    c22_tr [pos="86,28!"];
    c12_tl -> c12_br [color="#202124", penwidth=2.5, arrowhead=none];
    c21_bl -> c21_tr [color="#202124", penwidth=2.5, arrowhead=none];
    c22_bl -> c22_tr [color="#202124", penwidth=2.5, arrowhead=none];

    node [shape=plaintext, fixedsize=false, style="", fontsize=17,
          fontname="Noto Sans CJK TC", fontcolor="#5f6368"];
    p1  [label="1", pos="0,122!"];
    p2  [label="2", pos="58,122!"];
    p3  [label="3", pos="116,122!"];
    p4  [label="4", pos="190,58!"];
    p5  [label="5", pos="190,0!"];
    p6  [label="6", pos="116,-66!"];
    p7  [label="7", pos="58,-66!"];
    p8  [label="8 入口", pos="0,-66!", fontcolor="#b3261e", fontsize=19];
    p9  [label="9", pos="-74,0!"];
    p10 [label="10 出口", pos="-74,58!", fontcolor="#b3261e", fontsize=19];

    p8 -> c21 -> c22 -> c12 -> c11 -> p10;
