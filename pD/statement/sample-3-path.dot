digraph sample_3 {
    graph [layout=neato, overlap=true, splines=line, outputorder=nodesfirst,
           bgcolor="white", pad=0.2];
    node [fontname="Noto Sans Mono CJK TC", fontsize=22, shape=box,
          fixedsize=true, width=0.78, height=0.78, style="filled",
          fillcolor="#f6f8fa", color="#5f6368", penwidth=1.5];
    edge [color="#d94841", penwidth=4, arrowsize=0.8];

    c11 [label=".", pos="0,58!", fillcolor="#ffe9e7"];
    c12 [label="", pos="58,58!", fillcolor="#ffe9e7"];
    c13 [label=".", pos="116,58!"];
